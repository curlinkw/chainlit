# Use a single shared lockfile for the entire workspace.
# This is the default (true) and recommended for most monorepos, as it
# ensures a single version of each dependency across all packages.
shared-workspace-lockfile=true

# Hoist common development tools to the root `node_modules` so that
# binaries (eslint, prettier, etc.) are available at the workspace root.
# This is the standard pattern for monorepos.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=@types*

# CRITICAL: Disable the side-effects cache.
# pnpm caches the results of postinstall scripts. When Cypress is already in
# its store, the cache can cause pnpm to skip Cypress's postinstall script,
# which is responsible for downloading the actual Cypress binary. Setting this
# to false forces the postinstall to run, ensuring the binary is present.
# This is the definitive fix for the "Cypress binary is missing" error on CI.
side-effects-cache=false
